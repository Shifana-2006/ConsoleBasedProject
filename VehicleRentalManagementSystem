class Vehicle{

private int vehicleId;
private String vehicleModel;
private float vehiclePerdaycharge;
private boolean Available=true;//Important

public Vehicle(int vehicleId,String vehicleModel,float vehiclePerdaycharge){

this.vehicleId=vehicleId; //Read only variable
this.vehicleModel=vehicleModel; //mutable.
this.vehiclePerdaycharge=vehiclePerdaycharge;

}

public void setvehicleId(int vehicleId){// No setter  once created no need to update this.
    this.vehicleId=vehicleId;
}

public int getvehicleId(){
     return vehicleId;
}

public void setvehicleModel(String vehicleModel){
     this.vehicleModel=vehicleModel;
}

public String getvehicleModel(){
     return vehicleModel;
}

public void setvehiclePerdaycharge(float vehiclePerdaycharge){
       this.vehiclePerdaycharge=vehiclePerdaycharge;
}

public float getvehiclePerdaycharge(){
      return vehiclePerdaycharge;
}

public void setAvailable(boolean Available){
    this.Available=Available;
}

public boolean getAvailable(){
    return Available;
}


}

