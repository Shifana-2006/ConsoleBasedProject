class RentalService{

ArrayList<Vehicle> vehicles=new ArrayList<>();
ArrayList<Customer> customers=new ArrayList<>();
ArrayList<Rent> rents=new ArrayList<>();


Scanner sc=new Scanner(System.in);

public Customer authenticate(){

System.out.print("Enter Phone Number: ");
String customerPhonenumber=sc.nextLine();
//verify phone num
for(Customer c: customers){
if(customerPhonenumber.equals(c.getcustomerPhonenumber())){//c1,c2..
 System.out.println("Login Successfully");
 return c;//if found !! then exit from the whole method not loop
}
}
System.out.println("Invalid Login.Pls Enter Correct Num");
return null;

}

public void addVehicle(){

System.out.println("=====Add Vehicles=====");
System.out.print("Enter Vehicle Id: ");
int vehicleId=sc.nextInt();
for (Vehicle v : vehicles) {
if (vehicleId==v.getvehicleId()) {
     System.out.println("Vehicle ID already exists!");
     return;
     }
 }
sc.nextLine();//To clear the bug(buffered)
System.out.print("Enter Vehicle Model: ");
String vehicleModel=sc.nextLine();
System.out.print("Enter Per day Charge: ");
float vehiclePerdaycharge=sc.nextFloat();

//vehicle obj creation
Vehicle v=new Vehicle(vehicleId,vehicleModel,vehiclePerdaycharge);
//Add into ArrayList
vehicles.add(v);
System.out.println("Vehicle Added Succesfully");

}

public void displayVehicle(){

System.out.println("=====Display Vehicles=====");
if(vehicles.isEmpty()){
System.out.println("Vehicles not available");
}
else{
for(Vehicle v:vehicles){
System.out.println("Vehicle Id: " + v.getvehicleId());
System.out.println("Vehicle Model: " + v.getvehicleModel());
System.out.println("Per Day Charge: " + v.getvehiclePerdaycharge());
System.out.println("Available: " + v.getAvailable());

}
}

}

//Admin search veh by ID,As a Customer need to search by model.
//Search by ID → return use(coz ID unique)
//Search by Model → return Dont use(coz different id of veh has same model)

public void searchVehicle(){

System.out.println("=====Search Vehicle=====");
System.out.println("Enter Vehicle Model:");
String vehicleModel=sc.nextLine();
boolean found=false;
for(Vehicle v:vehicles){
if(vehicleModel.equalsIgnoreCase(v.getvehicleModel())){
found=true;
System.out.println("Vehicle Id: " + v.getvehicleId());
System.out.println("Vehicle Model: " + v.getvehicleModel());
System.out.println("Per Day Charge: " + v.getvehiclePerdaycharge());
System.out.println("Available: " + v.getAvailable());
}
}
if(!found){
System.out.println("Vehicle not found");
}

}


public void rentVehicle(Customer c){

System.out.println("=====Rent Vehicle=====");
System.out.println("Enter Vehicle Model:");
String vehicleModel=sc.nextLine();
boolean found=false;
for(Vehicle v:vehicles){
if(vehicleModel.equalsIgnoreCase(v.getvehicleModel())){
found=true;
System.out.println("Take rent");
System.out.println("Vehicle Id: " + v.getvehicleId());
System.out.println("Vehicle Model: " + v.getvehicleModel());
System.out.println("Per Day Charge: " + v.getvehiclePerdaycharge());
System.out.println("Available: "+v.getAvailable());

System.out.println("Enter Vehicle ID you want to rent: ");
int vehicleId=sc.nextInt();

if(vehicleId == v.getvehicleId()) {

if(v.getAvailable()){
System.out.println("Enter how many days do u want to rent: ");
int days=sc.nextInt();
float totalAmount=days*v.getvehiclePerdaycharge();
System.out.println("Total Amount: "+totalAmount);

int rentId = rents.size() + 1;
Date rentDate = new Date();
Date returnDate = null;
//add
Rent r=new Rent(rentId,rentDate,returnDate,totalAmount,c.getcustomerId(),v.getvehicleId());
rents.add(r);
//update 
v.setAvailable(false);
}
else{
System.out.println("Vehicle is already rented");
}
}
}
}
if(!found){
System.out.println("Vehicle not found");
}
}


public void returnVehicle(){

System.out.println("=====Return Vehicle=====");
System.out.println("Enter Vehicle Id to return: ");
int vehicleId=sc.nextInt();
for(Vehicle v : vehicles){
if(vehicleId==v.getvehicleId()){
if(!v.getAvailable()){
System.out.println("Vehicle Model: "+v.getvehicleModel());
System.out.println("Vehicle Returned Successfully");

v.setAvailable(true);

}
}
}

}
}
